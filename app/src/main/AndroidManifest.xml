<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Needed by the Vercel-backed catalogue and backdrop proxy. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the launcher-controlled Sound panel adjust and mute STREAM_MUSIC. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Settings card: connection type and IP for the Network page. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Settings card: lets "Uninstall" open the system uninstall dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+ hides installed packages by default; without this the grid is empty
         and the quick-settings panel can't tell which settings screens exist. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DREAM_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.APPLICATION_SETTINGS" /></intent>
        <!-- Hosts the "start screen saver now" activity -->
        <package android:name="com.android.systemui" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PureDeck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.PureDeck">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- HOME makes it selectable as a launcher; LEANBACK_LAUNCHER keeps it
                     openable as a normal app so it can be tested without flipping default -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
