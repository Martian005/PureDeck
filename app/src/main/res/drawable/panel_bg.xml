<?xml version="1.0" encoding="utf-8"?>
<!-- Floating glass card: rounded, lighter at the top where light hits, faint rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/panel_bottom"
        android:startColor="@color/panel_top" />
    <stroke
        android:width="1dp"
        android:color="@color/dock_edge" />
    <corners android:radius="30dp" />
</shape>
