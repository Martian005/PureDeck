<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="140"
    android:exitFadeDuration="180">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_focused" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/badge" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
