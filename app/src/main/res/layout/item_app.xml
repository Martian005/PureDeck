<?xml version="1.0" encoding="utf-8"?>
<!-- clipChildren=false up the tree, or the focused tile gets cropped when it scales. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="9dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true">

    <!-- 16:9 like tvOS tiles and like the TV banners Android apps ship. -->
    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/tile_glass_bg"
        android:foreground="@drawable/tile_rim"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:clipToOutline="true"
        android:outlineProvider="background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <!-- Name for tiles that only have a small icon. Many vendor system apps share one generic
             icon, so without this a row of them is indistinguishable. Hidden when a banner shows. -->
        <TextView
            android:id="@+id/appLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="7dp"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:shadowColor="@color/text_shadow"
            android:shadowRadius="6"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Specular sheen, shown only on the focused tile. -->
        <View
            android:id="@+id/gloss"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/tile_gloss" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
