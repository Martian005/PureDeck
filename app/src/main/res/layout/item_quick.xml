<?xml version="1.0" encoding="utf-8"?>
<!-- Children use duplicateParentState so they flip colour with the focused row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/quick_row_bg"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/quickIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/quick_icon_bg"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:padding="8dp"
        android:tint="@color/quick_fg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/quickLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/quick_fg"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/quickSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/quick_fg_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/quickValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxWidth="170dp"
        android:singleLine="true"
        android:textColor="@color/quick_fg_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/quickChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:src="@drawable/ic_qs_chevron"
        android:tint="@color/quick_fg_secondary"
        android:visibility="gone" />

</LinearLayout>
